{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blacksd/crd-schema-extractor/source.schema.json",
  "title": "CRD Source Configuration",
  "description": "Schema for source YAML config files in the sources/ directory.",
  "type": "object",
  "required": [
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "version",
          "license",
          "homepage"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Unique source identifier (lowercase, alphanumeric with hyphens)."
          },
          "type": {
            "type": "string",
            "enum": [
              "helm",
              "url",
              "git+github"
            ],
            "description": "Source type: helm chart, direct URL, or git repository."
          },
          "repo": {
            "type": "string",
            "format": "uri",
            "description": "Repository URL. For helm: chart repository URL. For git+github: GitHub repository URL (https://github.com/owner/repo)."
          },
          "chart": {
            "type": "string",
            "description": "Helm chart name. Required when type is helm."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Direct URL to a YAML manifest containing CRDs. Required when type is url. Supports {version} placeholder which is replaced with the version field value before fetching."
          },
          "path": {
            "type": "string",
            "description": "Subdirectory within the repository to restrict CRD scanning. Only used when type is git+github."
          },
          "version": {
            "type": "string",
            "pattern": "^v?[0-9]",
            "description": "Upstream version to extract (e.g., v1.17.2)."
          },
          "license": {
            "type": "string",
            "description": "SPDX license identifier (e.g., Apache-2.0). Must permit redistribution of derived artifacts."
          },
          "homepage": {
            "type": "string",
            "format": "uri",
            "description": "Project homepage URL."
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Helm --set values to pass during template rendering."
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowlist of CRD kinds or group/kind patterns to include."
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Denylist of CRD kinds or group/kind patterns to exclude."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "helm"
                }
              }
            },
            "then": {
              "required": [
                "repo",
                "chart"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "url"
                }
              }
            },
            "then": {
              "required": [
                "url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "git+github"
                }
              }
            },
            "then": {
              "required": [
                "repo"
              ]
            }
          }
        ]
      }
    }
  }
}